      if (needs_restart && !loading_override_) {
        // values already validated above; save for next launch, do NOT apply live
        persist_runtime_override(override_file_, to_persist);
        rcl_interfaces::msg::SetParametersResult result;
        result.successful = false;
        result.reason = "parameter requires restart: saved to user_config, applies on next launch";
        return result;
      }

      update_internal_params(updated_params);
      if (user_callback_) {
         user_callback_(updated_params);
      }
      // [rekise] persist accepted changes (volatile excluded); skip while loading overrides
      if (!loading_override_) {
        persist_runtime_override(override_file_, to_persist);
      }
      return rsl::to_parameter_result_msg({});
    }

