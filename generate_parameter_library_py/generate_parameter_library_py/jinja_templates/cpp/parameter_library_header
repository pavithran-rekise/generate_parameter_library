    // [rekise] point the listener at this node's override-layer file; accepted runtime
    // changes are persisted there (persist-before-commit) so they survive a relaunch.
    // ALSO load+apply the values already in that file (override layer) on top of the
    // factory params, so a relaunch picks up the latest durable change. Runtime params
    // only — read-only params are skipped. This is the READ half of the override layer;
    // it runs only when a node sets an override file (i.e. under the config-manager launch).
    void set_override_file(std::string path){
      override_file_ = std::move(path);
      if (override_file_.empty()) {
        return;
      }
      YAML::Node root;
      try {
        root = YAML::LoadFile(override_file_);
      } catch (...) {
        return;
      }
      if (!root || !root.IsMap() || root.size() == 0) {
        return;
      }
      const std::string fqn = root.begin()->first.as<std::string>();
      YAML::Node rp = root[fqn]["ros__parameters"];
      if (!rp || !rp.IsMap()) {
        return;
      }
      loading_override_ = true;  // [rekise] applying persisted overrides -> apply even required_restart, don't re-persist
      // [rekise] walk the tree so the override file accepts BOTH a flat dotted key
      // ("topic_name.depth: x") and a nested map ("topic_name: {depth: x}"). A map is
      // recursed; a scalar/sequence is a leaf parameter named by the dotted path.
      std::function<void(const std::string &, const YAML::Node &)> apply_node =
        [&](const std::string & path, const YAML::Node & node) {
          if (node.IsMap()) {
            for (auto it = node.begin(); it != node.end(); ++it) {
              const std::string key = it->first.as<std::string>();
              apply_node(path.empty() ? key : path + "." + key, it->second);
            }
            return;
          }
          const std::string name = prefix_ + path;
          if (!parameters_interface_->has_parameter(name)) {
            return;
          }
          try {
            const rclcpp::ParameterType t = parameters_interface_->get_parameter(name).get_type();
            rclcpp::Parameter p;
            switch (t) {
              case rclcpp::ParameterType::PARAMETER_DOUBLE:  p = rclcpp::Parameter(name, node.as<double>());      break;
              case rclcpp::ParameterType::PARAMETER_INTEGER: p = rclcpp::Parameter(name, node.as<int64_t>());     break;
              case rclcpp::ParameterType::PARAMETER_BOOL:    p = rclcpp::Parameter(name, node.as<bool>());        break;
              case rclcpp::ParameterType::PARAMETER_STRING:  p = rclcpp::Parameter(name, node.as<std::string>()); break;
              case rclcpp::ParameterType::PARAMETER_DOUBLE_ARRAY:  p = rclcpp::Parameter(name, node.as<std::vector<double>>());      break;
              case rclcpp::ParameterType::PARAMETER_INTEGER_ARRAY: p = rclcpp::Parameter(name, node.as<std::vector<int64_t>>());     break;
              case rclcpp::ParameterType::PARAMETER_BOOL_ARRAY:    p = rclcpp::Parameter(name, node.as<std::vector<bool>>());        break;
              case rclcpp::ParameterType::PARAMETER_STRING_ARRAY:  p = rclcpp::Parameter(name, node.as<std::vector<std::string>>()); break;
              default: return;
            }
            parameters_interface_->set_parameters({p});   // -> update(): validate + apply (restart-reject bypassed)
          } catch (...) {
            // read-only / type mismatch / invalid -> skip this key, keep going
          }
        };
      apply_node("", rp);
      loading_override_ = false;
    }

    private:
      void update_internal_params(Params updated_params) {
        std::lock_guard<std::mutex> lock(mutex_);
        params_ = std::move(updated_params);
      }

      std::string prefix_;
      Params params_;
      rclcpp::Clock clock_;
      std::shared_ptr<rclcpp::node_interfaces::OnSetParametersCallbackHandle> handle_;
      std::shared_ptr<rclcpp::node_interfaces::NodeParametersInterface> parameters_interface_;
      userParameterUpdateCB user_callback_;
      std::string override_file_;  // [rekise] override-layer file for persistence (empty = disabled)
      bool loading_override_ = false;  // [rekise] true while applying overrides: bypass restart-reject + skip persist

      rclcpp::Logger logger_;
      std::mutex mutable mutex_;
  };

